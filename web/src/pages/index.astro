---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { getApiHealth } from "../lib/api";

const health = await getApiHealth(env.API);
---

<Base title="Dashboard">
  {
    health.ok ? (
      <section class="card ok" role="status" data-state="ok">
        <p class="mono">API ok</p>
      </section>
    ) : (
      <section class="card error" role="alert" data-state="error">
        <h2 class="mono">API error</h2>
        <p>{health.error}</p>
      </section>
    )
  }
</Base>

<style>
  .card {
    border: 1px solid var(--border);
    border-left-width: 4px;
    border-radius: 6px;
    padding: 0.75rem 1rem;
  }
  .card p,
  .card h2 {
    margin: 0;
  }
  .card h2 {
    font-size: 1rem;
  }
  .ok {
    border-left-color: var(--ok);
  }
  .error {
    border-left-color: var(--error);
  }
  .error h2 {
    color: var(--error);
  }
</style>
