# Copy to ~/.config/command-center/bridge.env and `chmod 600` it. Never commit the real file.

# Fine-grained token, this repository only: Issues read/write, Metadata read.
# The bridge only reads issues and edits labels; it never pushes.
GH_TOKEN=

# owner/name of the repository behind origin.
CC_REPO=WH1TE-SHAD0W/command-center

# Root on the Hermes host. Holds repo/ (a clone) and worktrees/<issue>/.
# The same path is mounted into the worker containers.
CC_ROOT=/srv/command-center

# Telegram chat that gets blocked / gave_up / crashed notifications for every card.
TELEGRAM_CHAT_ID=

# Optional overrides.
# CC_TRIGGER_LABEL=agent:ready
# CC_WORKER_SKILL=command-center-worker
