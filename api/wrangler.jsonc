{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "command-center-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // No public address: reachable only through the web worker's service binding.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "command-center-db-local",
      "database_id": "placeholder-d1-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "command-center-files-local"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "placeholder-kv-id"
    }
  ]
}
