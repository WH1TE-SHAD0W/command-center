{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "command-center-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // No public address: reachable only through the web worker's service binding.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "command-center",
      "database_id": "fcf1dd6b-317a-438d-88ba-4fe751b8867b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "command-center"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "284bbda64e1b434b897149d61c8cec5c"
    }
  ]
}
